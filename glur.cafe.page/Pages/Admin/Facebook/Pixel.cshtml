@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model glur.cafe.page.Pages.Admin.Facebook.PixelModel
@{
    ViewData["Title"] = "Pixel & Conversions API";
    ViewData["ActiveMenu"] = "fb-pixel";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/Admin/Facebook" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h5 class="mb-0 fw-bold"><i class="bi bi-graph-up-arrow text-success me-2"></i>Pixel & Conversions API</h5>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <form method="post">
            @Html.AntiForgeryToken()

            <!-- Pixel (Browser-side) -->
            <div class="admin-card mb-4">
                <div class="admin-card-header d-flex align-items-center gap-2">
                    <i class="bi bi-browser-chrome text-primary"></i>
                    <span>Facebook Pixel (Browser-side)</span>
                </div>
                <div class="p-4">
                    <!-- Toggle -->
                    <div class="mb-4 d-flex align-items-center justify-content-between p-3 rounded-3" style="background:#f8fafc;border:1px solid #e2e8f0;">
                        <div>
                            <div class="fw-semibold">เปิดใช้งาน Pixel</div>
                            <small class="text-muted">ฝัง Pixel base code บนทุกหน้า</small>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   name="PixelEnabled" value="true"
                                   @(Model.PixelEnabled == "true" ? "checked" : "") style="width:3rem;height:1.5rem;cursor:pointer;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Pixel ID <span class="text-danger">*</span></label>
                        <input type="text" name="FacebookPixelId" value="@Model.FacebookPixelId"
                               class="form-control font-monospace" placeholder="เช่น 123456789012345" />
                        <small class="text-muted">ดูได้ที่ Meta Events Manager → Data Sources → Pixels</small>
                    </div>
                    <div class="rounded-3 p-3 mb-0" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                        <div class="small fw-semibold text-success mb-1"><i class="bi bi-check-circle me-1"></i>Events ที่จะ track อัตโนมัติ</div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                                <i class="bi bi-eye me-1"></i>PageView — ทุก request
                            </span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                                <i class="bi bi-envelope me-1"></i>Contact — เมื่อ submit ฟอร์ม
                            </span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                                <i class="bi bi-house me-1"></i>ViewContent — หน้า Index
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Conversions API (Server-side) -->
            <div class="admin-card mb-4">
                <div class="admin-card-header d-flex align-items-center gap-2">
                    <i class="bi bi-server text-warning"></i>
                    <span>Conversions API (Server-side) — ทางเลือก</span>
                </div>
                <div class="p-4">
                    <div class="alert alert-warning d-flex gap-2 mb-3" role="alert">
                        <i class="bi bi-shield-check flex-shrink-0 mt-1"></i>
                        <div class="small">
                            Conversions API ช่วยส่ง event จาก server โดยตรง ทำให้ข้อมูลแม่นกว่า browser tracking ที่อาจถูก adblocker บล็อก
                        </div>
                    </div>
                    @* Token เก็บใน appsettings.json เพื่อความปลอดภัย ไม่ผ่าน DB *@
                    <div class="rounded-3 p-3" style="background:#f8fafc;border:1px dashed #cbd5e1;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-shield-lock-fill text-success"></i>
                            <span class="fw-semibold small">Conversions API Token</span>
                            @if (Model.ConversionsTokenConfigured)
                            {
                                <span class="badge bg-success">✅ ตั้งค่าแล้ว</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">⚠️ ยังไม่ตั้งค่า</span>
                            }
                        </div>
                        <p class="small text-muted mb-2">
                            Token เก็บใน <code>appsettings.json</code> (ไม่เก็บใน Database เพื่อความปลอดภัย)
                        </p>
                        <pre class="rounded p-2 small mb-0" style="background:#1e293b;color:#e2e8f0;font-size:.78rem;">"FacebookSecrets": {
  "ConversionsToken": "EAAxxxxxxxxxx",
  "InstagramToken":   "IGQWxxxxxxxxxx"
}</pre>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" asp-page-handler="Test" class="btn btn-outline-teal px-4">
                    <i class="bi bi-send me-1"></i>ทดสอบ Test Event
                </button>
                <button type="submit" class="btn btn-teal px-4">
                    <i class="bi bi-floppy me-1"></i>บันทึกการตั้งค่า
                </button>
            </div>
        </form>
    </div>

    <!-- Side tips -->
    <div class="col-lg-4">
        <div class="admin-card">
            <div class="admin-card-header"><i class="bi bi-lightbulb me-2 text-warning"></i>เคล็ดลับ</div>
            <div class="p-3">
                <p class="small text-muted mb-2">
                    <strong>ตรวจสอบ Pixel:</strong><br />
                    ติดตั้ง <em>Meta Pixel Helper</em> Chrome extension เพื่อเช็คว่า Pixel ทำงานถูกต้อง
                </p>
                <p class="small text-muted mb-2">
                    <strong>Deduplication:</strong><br />
                    เมื่อใช้ทั้ง Browser Pixel และ Conversions API พร้อมกัน Meta จะ dedup event อัตโนมัติ
                </p>
                <p class="small text-muted mb-0">
                    <strong>Token Security:</strong><br />
                    Access Token เก็บเข้ารหัสใน database — ไม่ส่งไปยัง browser
                </p>
            </div>
        </div>
        <div class="admin-card mt-3">
            <div class="admin-card-header"><i class="bi bi-link-45deg me-2"></i>ลิงก์ที่เกี่ยวข้อง</div>
            <div class="p-3 d-flex flex-column gap-2">
                <a href="https://business.facebook.com/events_manager" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Meta Events Manager
                </a>
                <a href="https://developers.facebook.com/tools/debug" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Sharing Debugger
                </a>
            </div>
        </div>
    </div>
</div>
