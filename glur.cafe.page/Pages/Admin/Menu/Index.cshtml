@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model glur.cafe.page.Pages.Admin.Menu.IndexModel
@{
    ViewData["Title"] = "เมนูหน้าร้าน";
    ViewData["ActiveMenu"] = "menu";
    ViewData["UnreadCount"] = 0;
}

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-cup-straw me-2"></i>หมวดเมนูหน้าร้าน (@Model.Folders.Count)</span>
        <a href="/Menu" target="_blank" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-up-right me-1"></i>ดูหน้าเมนู
        </a>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ฟอร์มเพิ่มหมวด -->
    <form method="post" asp-page-handler="Create" class="row g-2 align-items-end px-3 py-3 border-bottom">
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="form-label small mb-1">ชื่อหมวดหมู่</label>
            <input type="text" name="Name" class="form-control form-control-sm" placeholder="เช่น กาแฟ, ขนม, โปรโมชั่น" required maxlength="100" />
            <div class="form-text">ชื่อ <code>Header</code> = รูปสไลด์บนสุดของหน้าเมนู</div>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Bootstrap Icon</label>
            <input type="text" name="IconClassName" class="form-control form-control-sm" placeholder="bi-cup-hot" maxlength="50" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">ลำดับ</label>
            <input type="number" name="DisplayOrder" class="form-control form-control-sm" value="@Model.NextOrder" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm btn-teal"><i class="bi bi-plus-lg me-1"></i>เพิ่มหมวด</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-header">
                <tr>
                    <th style="width:50px">#</th>
                    <th>ชื่อหมวด</th>
                    <th style="width:60px">Icon</th>
                    <th style="width:80px">จำนวนสื่อ</th>
                    <th style="width:70px">ลำดับ</th>
                    <th style="width:80px">สถานะ</th>
                    <th style="width:180px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Folders)
                {
                    <tr>
                        <td class="text-muted small">@f.Id</td>
                        <td class="fw-semibold">
                            @f.Name
                            @if (f.Name == "Header")
                            {
                                <span class="badge bg-warning text-dark ms-1">สไลด์บนสุด</span>
                            }
                        </td>
                        <td><i class="bi @f.IconClassName fs-5"></i></td>
                        <td class="text-center">@f.Items.Count</td>
                        <td class="text-center">@f.DisplayOrder</td>
                        <td>
                            <form method="post" asp-page-handler="Toggle">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@f.Id" />
                                <button type="submit" class="btn btn-sm @(f.IsActive ? "btn-success" : "btn-secondary") rounded-pill" style="font-size:0.7rem">
                                    @(f.IsActive ? "เปิด" : "ปิด")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a href="/Admin/Menu/Items?id=@f.Id" class="btn btn-sm btn-teal me-1">
                                <i class="bi bi-images me-1"></i>สื่อ
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                    data-bs-toggle="modal" data-bs-target="#editModal-@f.Id">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('ลบหมวดนี้และไฟล์ทั้งหมดข้างใน?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@f.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>

                    <!-- Edit modal -->
                    <div class="modal fade" id="editModal-@f.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <form method="post" asp-page-handler="Edit">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <div class="modal-header">
                                        <h6 class="modal-title">แก้ไขหมวด: @f.Name</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-2">
                                            <label class="form-label small">ชื่อหมวดหมู่</label>
                                            <input type="text" name="Name" class="form-control form-control-sm" value="@f.Name" required maxlength="100" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">Bootstrap Icon</label>
                                            <input type="text" name="IconClassName" class="form-control form-control-sm" value="@f.IconClassName" maxlength="50" />
                                        </div>
                                        <div>
                                            <label class="form-label small">ลำดับ</label>
                                            <input type="number" name="DisplayOrder" class="form-control form-control-sm" value="@f.DisplayOrder" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-sm btn-teal">บันทึก</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>
